{
  "name": "pre-sales-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "npm run psops:test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "psops:test": "tsx --test lib/psops/ingest/__tests__/*.test.ts lib/psops/services/__tests__/*.test.ts",
    "psops:seed": "tsx scripts/psops-seed.ts",
    "psops:collect": "tsx scripts/psops-collect.ts",
    "psops:reconcile": "tsx scripts/psops-reconcile.ts",
    "framework:parity": "tsx scripts/framework-parity.ts"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "cheerio": "~1.0.0",
    "exceljs": "4.4.0",
    "fflate": "^0.8.3",
    "html-to-image": "1.11.13",
    "i18next": "^23.10.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^0.363.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "sass": "^1.72.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.2",
    "@netlify/plugin-nextjs": "^5.15.9",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "prisma": "^5.11.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.3"
  }
}
