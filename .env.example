# Banco de dados PostgreSQL (Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth - gere um secret com: openssl rand -base64 32
NEXTAUTH_SECRET="seu-secret-aqui"

# URL da aplicação (após o deploy na Vercel, atualizar com a URL real)
NEXTAUTH_URL="https://seu-projeto.vercel.app"

# ZD Auto Config — provisionador de demos Zendesk (serviço separado, em Python).
# O item no menu superior só aparece para ADMIN e SC, e só se esta URL existir.
NEXT_PUBLIC_ZD_AUTOCFG_URL="https://zd-auto-config.suaempresa.com"

# Segredo compartilhado com o serviço para o login único (SSO). Só servidor —
# NUNCA prefixe com NEXT_PUBLIC_. Gere com: openssl rand -base64 48
# O mesmo valor vai em ZDCFG_SSO_SECRET no host do serviço.
ZDCFG_SSO_SECRET=""
