# Banco de dados PostgreSQL (Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth - gere um secret com: openssl rand -base64 32
NEXTAUTH_SECRET="seu-secret-aqui"

# URL da aplicação (após o deploy na Vercel, atualizar com a URL real)
NEXTAUTH_URL="https://seu-projeto.vercel.app"

# ZD Auto Config — provisionador de demos Zendesk (roda dentro do site).
# Chave Fernet que cifra os tokens Zendesk na tabela zdcfg_environments.
# Só servidor: NUNCA prefixe com NEXT_PUBLIC_. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url')+'=')"
# Se já existe cofre migrado, use a MESMA chave que o cifrou.
ZDCFG_FERNET_KEY=""
