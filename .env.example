# Banco de dados PostgreSQL (Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth - gere um secret com: openssl rand -base64 32
NEXTAUTH_SECRET="seu-secret-aqui"

# URL da aplicação (após o deploy na Vercel, atualizar com a URL real)
NEXTAUTH_URL="https://seu-projeto.vercel.app"

# ZD Auto Config — provisionador de demos Zendesk (roda dentro do site).
# Chave Fernet que cifra os tokens Zendesk na tabela zdcfg_environments.
# Só servidor: NUNCA prefixe com NEXT_PUBLIC_. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url')+'=')"
# Se já existe cofre migrado, use a MESMA chave que o cifrou.
ZDCFG_FERNET_KEY=""

# Pre-Sales Ops — monitoramento das novidades do Zendesk.
# Segredo que o agendador do Netlify manda no header x-psops-secret para
# disparar a coleta (07:00 BRT) e a reconciliação (01:00 BRT). Mínimo 16
# caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Sem ele, a coleta continua possível pelo botão "Coletar agora" (só admin).
PSOPS_INGEST_SECRET=""
# Opcionais — os padrões já servem:
# PSOPS_HTTP_TIMEOUT_MS=20000
# PSOPS_HTTP_RETRIES=3
# PSOPS_PAGE_SIZE=30
# PSOPS_MAX_PAGES=3
# PSOPS_DIVERGENCIA_DIAS=7
# PSOPS_SAUDE_ATENCAO_DIAS=45
# PSOPS_SAUDE_CRITICO_DIAS=90
# PSOPS_SAUDE_CRITICO_PENDENTES=8
