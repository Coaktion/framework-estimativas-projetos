// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique
  password      String?           // New field for custom login
  name          String?
  picture       String?
  role          String            @default("IMPL") // Segmento: ADMIN, SC, AE, PM, IMPL
  isAdmin       Boolean           @default(false)
  createdAt     DateTime          @default(now())
  /// último login pelo Google
  ultimoLoginEm  DateTime?
  /// última vez que usou o portal (atualizado no máximo a cada 10 min)
  ultimoAcessoEm DateTime?
  /// quantos logins pelo Google desde que passou a ser registrado
  totalLogins    Int               @default(0)
  projects      Project[]
  projectVers   ProjectVersion[]
  frameworkVers FrameworkVersion[]
  aeEstimates   AEEstimate[]
  preferences   UserPreference?
  zdEnvironments ZdEnvironment[]
  apiKeys       ApiKey[]
}

model UserPreference {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  theme           String   @default("light") // light, dark
  isCompact       Boolean  @default(false)
  language        String   @default("pt") // pt, en, es
  hiddenItems     String   @default("[]") // JSON array of package IDs
  layoutConfig    String   @default("{}") // JSON object com ordem e subcategorias personalizadas
  presets         String   @default("[]") // JSON array of preset objects
  updatedAt       DateTime @updatedAt
}

model AEEstimate {
  id            Int      @id @default(autoincrement())
  clientName    String
  zohoLink      String?  // Link opcional para o deal no Zoho
  data          String   // JSON string with selected options
  resultHours   Float
  needsSC       Boolean
  version       Int      @default(1)
  parentId      Int?
  parent        AEEstimate? @relation("VersionHistory", fields: [parentId], references: [id])
  children      AEEstimate[] @relation("VersionHistory")
  createdAt     DateTime @default(now())
  createdBy     Int
  creator       User     @relation(fields: [createdBy], references: [id])
  // Exclusão só na tela (ver Project.deletedAt).
  deletedAt     DateTime?
  deletedBy     Int?
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  displayName  String    @default("")
  displayNameEn String   @default("") // Nome exibido em inglês (vazio = usa displayName)
  displayNameEs String   @default("") // Nome exibido em espanhol (vazio = usa displayName)
  displayOrder Int       @default(0)
  parentName   String?
  parent       Category? @relation("CategoryHierarchy", fields: [parentName], references: [name])
  children     Category[] @relation("CategoryHierarchy")
  isActive     Boolean   @default(true)
  // Plano Zendesk mínimo da CATEGORIA, por SKU. Vazio = sem restrição.
  // Funciona como porteira INDEPENDENTE da restrição dos itens: abaixo do
  // mínimo a categoria inteira desaparece do framework (ex.: ADPP só em
  // Suite Enterprise), mesmo que algum item dela não tenha restrição própria.
  minPlanCS    String    @default("") // team, growth, professional, enterprise
  minPlanES    String    @default("") // team, growth, professional, enterprise
  // Linha do card de Implantação em que os itens desta categoria entram:
  // WORKSHOP, SETUP, TRAINING ou GOLIVE. Subcategorias herdam a da raiz.
  implementationPhase String @default("SETUP")
  packages     Package[]
}

model Skill {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  nameEn    String    @default("") // Nome exibido em inglês (vazio = usa name)
  nameEs    String    @default("") // Nome exibido em espanhol (vazio = usa name)
  isActive  Boolean   @default(true)
  packages  Package[]
}

model Package {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  nameEn          String   @default("") // Nome exibido em inglês (vazio = usa name)
  nameEs          String   @default("") // Nome exibido em espanhol (vazio = usa name)
  hours           Float
  tooltip         String?  @default("")
  tooltipEn       String?  @default("") // Tooltip em inglês (vazio = usa tooltip)
  tooltipEs       String?  @default("") // Tooltip em espanhol (vazio = usa tooltip)
  // Atalhos do framework (Treinamento / Workshop / Go-live):
  //  - moduleLink: em itens de categorias de fase WORKSHOP/TRAINING, o módulo
  //    (categoria raiz) a que o item pertence;
  //  - goLiveShortcutQty: em itens de categorias de fase GOLIVE, a quantidade
  //    que o atalho Go-live preenche (0 = o atalho não mexe no item).
  moduleLink        String   @default("")
  goLiveShortcutQty Int      @default(0)
  scopeIncluded   String   @default("")
  scopeExcluded   String   @default("")
  categoryName    String?
  category        Category? @relation(fields: [categoryName], references: [name])
  skillName       String?
  skill           Skill?    @relation(fields: [skillName], references: [name])
  link            String?
  isActive        Boolean  @default(true)
  sdDiscovery     Boolean  @default(false)
  // Plano Zendesk mínimo por SKU. Vazio = sem restrição (vale em todos os planos).
  minPlanCS       String   @default("") // team, growth, professional, enterprise
  minPlanES       String   @default("") // team, growth, professional, enterprise
  
  // Lógica Condicional
  dependsOnItemId Int?
  dependsOnItem   Package? @relation("ItemDependencies", fields: [dependsOnItemId], references: [id])
  dependentItems  Package[] @relation("ItemDependencies")

  createdAt      DateTime @default(now())
  excludedFromVariables String? @default("[]") // JSON string array of variable keys to exclude this item from
}

model Variable {
  id             Int      @id @default(autoincrement())
  key            String   @unique
  label          String   @default("") // Rótulo em português (vazio = usa key)
  labelEn        String   @default("") // Rótulo em inglês (vazio = usa label/key)
  labelEs        String   @default("") // Rótulo em espanhol (vazio = usa label/key)
  value          String   // Valor base (ex: 25 ou 0.5)
  type           String   @default("PERCENT") // PERCENT, FLAT, MIXED
  flatValue      Float?   @default(0)
  category       String?
  isActive       Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  
  // Incidência Granular
  targetItems     String?  @default("[]") // JSON array de IDs de itens
  targetCategories String? @default("[]") // JSON array de nomes de categorias
  excludedItems    String? @default("[]") // JSON array de IDs de itens para excluir
}

model FrameworkVersion {
  id          Int      @id @default(autoincrement())
  versionName String
  type        String   @default("SC_AE") // SC_AE, DEV, CONSULTING
  data        String   // JSON string
  createdAt   DateTime @default(now())
  createdBy   Int?
  creator     User?    @relation(fields: [createdBy], references: [id])
}

model Project {
  id          Int              @id @default(autoincrement())
  name        String
  ownerId     Int
  owner       User             @relation(fields: [ownerId], references: [id])
  status      String           @default("DRAFT")
  isPrivate   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  versions    ProjectVersion[]
  spreadsheets Spreadsheet[]
  // Exclusão só na tela: o projeto some das listas, mas continua no banco e
  // só um admin o vê e restaura (Admin › Estimativas excluídas).
  deletedAt   DateTime?
  deletedBy   Int?
}

model ProjectVersion {
  id                  Int      @id @default(autoincrement())
  projectId           Int
  project             Project  @relation(fields: [projectId], references: [id])
  versionName         String   // Gerado automaticamente (V1, V2...) — não editável pelo usuário
  // Sobre o que trata a versão. Obrigatória ao salvar uma NOVA versão; versões
  // antigas (anteriores à numeração automática) ficam sem.
  description         String?
  data                String   // JSON string
  technicalScopeLink  String?
  zohoLink            String?
  
  // Overrides and percentages
  gpPercent           Float    @default(25.0)
  discoveryPercent    Float    @default(0.0)
  validationPercent   Float    @default(0.0)
  
  gpOverride          Float?
  discoveryOverride   Float?
  validationOverride  Float?
  
  safetyHours         String?  // JSON object mapping skill names to extra hours

  // Total geral da versão, congelado no momento do salvamento.
  // Existe para que a tela de Projetos possa mostrar "V1 · 108h" sem abrir e
  // recalcular cada versão — e para que o número exibido seja o que foi
  // acordado naquela versão, mesmo que a biblioteca de itens mude depois.
  // Mesmo princípio de AEEstimate.resultHours.
  totalHours          Float    @default(0)

  createdAt           DateTime @default(now())
  createdBy           Int?
  creator             User?    @relation(fields: [createdBy], references: [id])
  // Exclusão só na tela (ver Project.deletedAt).
  deletedAt           DateTime?
  deletedBy           Int?
}

model Spreadsheet {
  id        Int      @id @default(autoincrement())
  name      String
  content   String   // CSV/XLSX content or path
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

/// Cofre de ambientes Zendesk do ZD Auto Config (services/zd-auto-config).
/// O site só DECLARA a tabela (para o `prisma db push` não apagá-la); quem lê e
/// grava é o serviço Python. `secretEnc` é cifrado pelo serviço (Fernet) com a
/// chave ZDCFG_FERNET_KEY, que só existe no host do serviço.
model ZdEnvironment {
  id         String   @id
  name       String
  subdomain  String
  authType   String   @default("token") // "token" | "oauth"
  adminEmail String? // modo token
  clientId   String? // modo oauth
  secretEnc  String // token de API ou client secret, cifrado
  shared     Boolean  @default(false)
  ownerId    Int
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@unique([ownerId, name])
  @@index([shared])
  @@map("zdcfg_environments")
}

// =============================================================================
// Pre-Sales Ops — monitoramento das novidades do Zendesk (lib/psops)
// -----------------------------------------------------------------------------
// Só ACRESCENTA tabelas: nenhum model acima é alterado. Prefixo PsOps nos
// models e psops_ nas tabelas, no mesmo padrão do zdcfg_ do ZD Auto Config.
//
// Ids de pessoa (donoId, responsavelId, usuarioId, autorId) são String com o
// id do User do portal, SEM relação: o módulo não mexe no model User e o
// `db push` não precisa tocar em tabela existente.
// =============================================================================

// ─────────────────────────────── Enums ──────────────────────────────────────

enum PsOpsSourceKind {
  CATEGORY
  SECTION
  ARTICLE
}

enum PsOpsProduto {
  SUPPORT
  MESSAGING
  CONTACT_CENTER
  KNOWLEDGE
  AI_AGENTS
  COPILOT
  ANALYTICS
  WFM
  QA
  ADMIN_SEGURANCA
  DEVELOPER_API
  MARKETPLACE
  OUTRO
}

/// Frentes do nosso catálogo de propostas. É a ponte entre o sinal externo
/// e os nossos artefatos internos.
enum PsOpsModulo {
  SUPPORT
  VOICE
  KNOWLEDGE
  COPILOT
  AI_AGENTS
  ANALYTICS
  WFM
  QA
  INTEGRACOES
  OUTRO
}

enum PsOpsSignalTipo {
  GA
  EAP_BETA
  DEPRECATION
  BREAKING_CHANGE
  PRICING_PACKAGING
  UX_INTERFACE
  FIX_MINOR
}

enum PsOpsSignalStatus {
  NOVO
  TRIADO
  DESCARTADO
  /// Filtrado pelo detector de ruído. Continua pesquisável, fora da fila.
  AUTO_ARQUIVADO
  /// A classificação falhou a validação de schema. Entra na fila sem metadados.
  NAO_CLASSIFICADO
}

/// Os quatro destinos de impacto. ESTUDO produz uma ficha da feature
/// (PsOpsStudyNote); os outros três atualizam um PsOpsArtifact.
enum PsOpsImpacto {
  ESTUDO
  DEMO
  ESTIM
  ESCOPO
  /// não é destino da triagem: atualizar a skill de escopo depois que um
  /// documento de estimativa mudou (services/skill.ts)
  SKILL
}

enum PsOpsArtifactTipo {
  DEMO_TEMPLATE
  FRAMEWORK
  ESCOPO
}

/// Onde mora a verdade sobre "este artefato foi atualizado".
/// PORTAL: o artefato mora numa tabela deste portal — a atualização é o
/// próprio write, então revisaoVerificadaEm é preenchido por construção.
enum PsOpsVerifyFonte {
  PORTAL
  GDRIVE
  ZENDESK_ADMIN
  NENHUMA
}

enum PsOpsActivityStatus {
  TODO
  DOING
  DONE
  CANCELADA
}

// ─────────────────────── Camada 1 · Ingestão ────────────────────────────────

model PsOpsSource {
  id     String          @id @default(cuid())
  key    String          @unique
  nome   String
  kind   PsOpsSourceKind
  /// id da categoria, seção ou artigo no Help Center do Zendesk
  zendeskId String
  baseUrl   String       @default("https://support.zendesk.com")
  locale    String       @default("en-us")
  /// true para artigos atualizados no lugar (ex.: a lista de EAPs).
  /// Esses não ganham created_at novo — são controlados por hash de body.
  isLiveArticle Boolean  @default(false)
  ativo         Boolean  @default(true)

  /// maior created_at já processado nesta fonte
  watermark     DateTime?
  ultimoRunEm   DateTime?
  ultimoRunOk   Boolean?
  ultimoRunErro String?

  rawItems PsOpsRawItem[]
  runs     PsOpsIngestRun[]

  @@map("psops_sources")
}

model PsOpsIngestRun {
  id           String    @id @default(cuid())
  sourceId     String?
  source       PsOpsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  iniciadoEm   DateTime  @default(now())
  finalizadoEm DateTime?
  ok           Boolean   @default(false)
  itensNovos       Int   @default(0)
  itensAtualizados Int   @default(0)
  sinaisCriados    Int   @default(0)
  sinaisArquivados Int   @default(0)
  erro         String?

  @@index([iniciadoEm])
  @@map("psops_ingest_runs")
}

/// Camada crua imutável. Guarda o payload da Zendesk sem transformação, para
/// que uma mudança de taxonomia possa reprocessar o histórico sem rebuscar.
model PsOpsRawItem {
  id         String   @id @default(cuid())
  sourceId   String
  source     PsOpsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId String
  titulo     String
  htmlUrl    String
  secaoId    String?
  criadoEm     DateTime
  atualizadoEm DateTime
  editadoEm    DateTime?
  labels       String[]
  /// sha256 do body — detecta edição em artigo-vivo
  bodyHash   String
  payload    Json
  coletadoEm DateTime @default(now())

  /// quando a tradução pt-br do Zendesk foi aplicada aos sinais deste artigo
  traducaoPtEm DateTime?
  /// idem, espanhol
  traducaoEsEm DateTime?

  signals PsOpsSignal[]

  @@unique([sourceId, externalId, bodyHash])
  @@index([criadoEm])
  @@map("psops_raw_items")
}

// ───────────── Camada 2 · Sinais atômicos (normalizados) ────────────────────

model PsOpsSignal {
  id        String       @id @default(cuid())
  rawItemId String
  rawItem   PsOpsRawItem @relation(fields: [rawItemId], references: [id], onDelete: Cascade)

  /// Posição estável do sinal dentro do body: "2.1.3" = 3º bullet do 1º H4
  /// do 2º H2. Junto com rawItemId dá idempotência ao reprocessamento.
  ancora String

  /// sha256 do texto do sinal. Quando um artigo é editado ele gera um novo
  /// RawItem (hash de body diferente) e a âncora pode deslocar — a assinatura
  /// é o que impede recriar sinal para conteúdo que já tínhamos.
  assinatura String

  titulo         String
  resumoPtBr     String?
  trechoOriginal String  @db.Text

  /// título e trecho da tradução pt-br publicada pelo próprio Zendesk no Help
  /// Center. Só preenchidos quando a estrutura da tradução bate com a original
  /// bullet a bullet — na dúvida, fica em inglês.
  tituloPt String?
  trechoPt String? @db.Text
  /// idem, espanhol (o portal em es mostra estes)
  tituloEs String?
  trechoEs String? @db.Text

  produto PsOpsProduto
  modulo  PsOpsModulo
  tipo    PsOpsSignalTipo

  planoMinimo        String?
  requerConfiguracao Boolean @default(false)
  requerDev          Boolean @default(false)
  afetaPreco         Boolean @default(false)
  dataLimite         DateTime?

  /// 0–100. Ordena a fila de leitura. Sugestão, nunca decisão.
  score             Int
  impactosSugeridos PsOpsImpacto[]
  /// "regras" ou "llm:<modelo>" — rastreia quem classificou
  classificadoPor   String
  motivoRuido       String?

  status   PsOpsSignalStatus @default(NOVO)
  criadoEm DateTime          @default(now())

  triage     PsOpsTriage?
  /// decisão de cada dono de frente (e sugestões de outras pessoas)
  decisoes   PsOpsDecisao[]
  initiative PsOpsInitiative?
  aplicacoes PsOpsArtifactSignal[]
  studyNote  PsOpsStudyNote?

  @@unique([rawItemId, ancora])
  @@index([assinatura])
  @@index([status, score(sort: Desc)])
  @@index([produto])
  @@index([criadoEm])
  @@map("psops_signals")
}

// ──────────────── Camada 3 · Triagem (julgamento humano) ────────────────────

model PsOpsTriage {
  id       String      @id @default(cuid())
  signalId String      @unique
  signal   PsOpsSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  usuarioId      String
  decididoEm     DateTime       @default(now())
  impactos       PsOpsImpacto[]
  motivoDescarte String?
  nota           String?

  @@index([usuarioId])
  @@map("psops_triages")
}

// ─────────────── Camada 4 · Geração (iniciativa + atividades) ───────────────

/// Decisão de elegibilidade de UM dono numa frente: cada dono decide a sua
/// (Demo, Estimativa, Escopo; Estudo é de cada SE). Quem marca a frente de
/// outra pessoa deixa uma sugestão (sugeridoPor), que o dono vê na triagem.
model PsOpsDecisao {
  id          String       @id @default(cuid())
  signalId    String
  signal      PsOpsSignal  @relation(fields: [signalId], references: [id], onDelete: Cascade)
  impacto     PsOpsImpacto
  /// User.id do dono da frente
  donoId      String
  /// FAZER | NAO_FAZER; null = ainda não decidiu (só há sugestão)
  decisao     String?
  decididoEm  DateTime?
  sugeridoPor String?
  sugeridoEm  DateTime?
  /// a atividade criada quando o dono decidiu FAZER
  activityId  String?

  @@unique([signalId, impacto, donoId])
  @@index([donoId, decisao])
  @@map("psops_decisoes")
}

model PsOpsInitiative {
  id       String      @id @default(cuid())
  signalId String      @unique
  signal   PsOpsSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  titulo     String
  /// ciclo semanal, formato ISO week: "2026-W33"
  ciclo String
  criadoEm   DateTime @default(now())

  atividades PsOpsActivity[]

  @@index([ciclo])
  @@map("psops_initiatives")
}

model PsOpsActivity {
  id           String           @id @default(cuid())
  /// null só nas tarefas que não nascem de uma novidade (SKILL vinda de um
  /// commit feito direto no Mapa)
  initiativeId String?
  initiative   PsOpsInitiative? @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  tipo   PsOpsImpacto
  titulo String

  /// null para atividades de ESTUDO (que produzem uma ficha, não atualizam ativo)
  artifactId String?
  artifact   PsOpsArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  /// id do User do portal. Herdado do dono do artefato na criação.
  responsavelId String?
  status        PsOpsActivityStatus @default(TODO)

  /// [{ "t": "texto do item", "d": false, "evidencia": null }]
  dod Json

  /// Como provar que isto foi feito, sem confiar no clique. Ex.:
  /// { "fonte": "ZENDESK_ADMIN", "endpoint": "/api/v2/triggers",
  ///   "caminho": "triggers[].title", "contem": "Voice AI" }
  criterioVerificavel Json?

  concluidoEm  DateTime?
  concluidoPor String?

  studyNote  PsOpsStudyNote?
  aplicacoes PsOpsArtifactSignal[]

  @@index([responsavelId, status])
  @@index([artifactId])
  @@index([status, tipo])
  @@map("psops_activities")
}

/// Ficha de estudo da feature — o que a atividade de ESTUDO produz.
/// Vira a base de conhecimento de produto do time, pesquisável no Pre-Sales Ops.
model PsOpsStudyNote {
  id String @id @default(cuid())

  signalId String      @unique
  signal   PsOpsSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  activityId String?        @unique
  activity   PsOpsActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  /// O que é, em duas linhas, sem jargão de produto
  oQueE            String? @db.Text
  comoFunciona     String? @db.Text
  preRequisitos    String? @db.Text
  limitacoes       String? @db.Text
  planoNecessario  String?
  /// docs oficiais lidos durante o estudo
  linksConsultados String[]
  testadoEmSandbox Boolean @default(false)
  motivoNaoTestado String?

  autorId     String?
  versao      Int       @default(1)
  publicadoEm DateTime?
  atualizadoEm DateTime @updatedAt

  @@index([publicadoEm])
  @@map("psops_study_notes")
}

// ───────────── Camada 5 · Artefatos e rastreabilidade ───────────────────────

model PsOpsArtifact {
  id String @id @default(cuid())

  /// chave estável, ex. "FRAMEWORK:VOICE", "ESCOPO:KNOWLEDGE", "DEMO_TEMPLATE"
  chave  String            @unique
  tipo   PsOpsArtifactTipo
  modulo PsOpsModulo?
  nome   String

  /// id do User do portal. É de onde a atividade herda o responsável.
  donoId String?
  versao String @default("1")

  // ── As três datas. Nunca colapsar em uma só. ──
  /// alguém clicou "concluir" — promessa
  revisaoDeclaradaEm  DateTime?
  /// a fonte confirmou a mudança — o que o semáforo de saúde usa
  revisaoVerificadaEm DateTime?
  /// quando o reconciliador rodou por último nesta linha
  conferidoEm         DateTime?

  fonteVerificacao PsOpsVerifyFonte @default(NENHUMA)
  /// fileId do Drive, subdomínio do tenant, nome da tabela do portal…
  fonteRef         String?
  /// hash/checksum/version do último estado observado na fonte
  fonteAssinatura  String?

  /// true quando declarada e verificada divergem além do limite configurado
  divergente         Boolean @default(false)
  divergenciaDetalhe String?

  atividades PsOpsActivity[]
  aplicacoes PsOpsArtifactSignal[]
  atualizacoes PsOpsArtifactUpdate[]

  @@index([tipo])
  @@index([donoId])
  @@map("psops_artifacts")
}

/// Histórico de atualizações de um artefato — o "commit": quem atualizou,
/// quando e o que mudou (descrição obrigatória). Vem do Mapa de Artefatos ou
/// da conclusão de uma atividade (activityId/signalId dizem de onde veio).
/// A última atualização do artefato é a data do commit mais recente, também
/// gravada em PsOpsArtifact.revisaoDeclaradaEm.
model PsOpsArtifactUpdate {
  id         String        @id @default(cuid())
  artifactId String
  artifact   PsOpsArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  /// id do User do portal
  autorId    String
  descricao  String        @db.Text
  criadoEm   DateTime      @default(now())
  /// atividade e feature de origem, quando o commit veio da conclusão
  activityId String?
  signalId   String?

  @@index([artifactId, criadoEm])
  @@map("psops_artifact_updates")
}

/// A tabela pequena que entrega o valor grande: por que este artefato está do
/// jeito que está. Permite a leitura reversa artefato → sinais → announcements.
model PsOpsArtifactSignal {
  id String @id @default(cuid())

  artifactId String
  artifact   PsOpsArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  signalId   String
  signal     PsOpsSignal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  activityId String
  activity   PsOpsActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  aplicadoEm DateTime @default(now())
  /// versão do artefato resultante desta aplicação
  versaoResultante String?

  @@unique([artifactId, signalId, activityId])
  @@index([signalId])
  @@map("psops_artifact_signals")
}

// Configuração da Calculadora AE (números e fórmulas), editada no painel Admin.
// Cada salvamento cria uma linha nova e imutável; a ativa é a mais recente.
// Estimativas guardam o id da configuração usada, para reabrirem com o mesmo cálculo.
model AeConfig {
  id        Int      @id @default(autoincrement())
  data      String   // JSON: { numbers, formulas, settings }
  note      String?
  createdAt DateTime @default(now())
  createdBy Int?
}

// =============================================================================
// Agendamento (Booking) — regras e Google Agenda de cada anfitrião (lib/booking)
// -----------------------------------------------------------------------------
// Só ACRESCENTA tabelas. Ids de pessoa são o id do User do portal, SEM relação
// (mesmo padrão do Pre-Sales Ops): o model User não muda.
// =============================================================================

/// Anfitrião do Agendamento: regras (JSON normalizado por lib/booking/config)
/// e conexão com o Google Agenda. Tokens cifrados com Fernet (lib/booking/google).
model BookingHost {
  userId          Int       @id
  config          Json
  accepting       Boolean   @default(true)
  googleEmail     String?
  refreshTokenEnc String?
  accessTokenEnc  String?
  accessExpiresAt DateTime?
  timeZone        String?
  connectedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("booking_hosts")
}

/// Um agendamento feito pelo app: a reunião (ou os horários de uma reserva
/// múltipla) e os bloqueios criados junto, com os ids dos eventos no Google.
model BookingRecord {
  id             String   @id
  hostId         Int
  requesterId    Int?
  requesterEmail String
  requesterName  String
  title          String
  typeId         String
  typeName       String
  multi          Boolean  @default(false)
  meetings       Json
  blocks         Json
  firstStart     DateTime
  lastEnd        DateTime
  /// Idempotência: o mesmo pedido reenviado devolve o resultado original.
  requestId      String?
  result         Json?
  createdAt      DateTime @default(now())

  @@unique([hostId, requestId])
  @@index([hostId, lastEnd])
  @@index([requesterId, lastEnd])
  @@map("booking_records")
}

/// Registro de atividade de cada anfitrião (agendamentos, recusas, falhas).
model BookingLog {
  id        Int      @id @default(autoincrement())
  hostId    Int
  level     String
  code      String
  data      Json
  createdAt DateTime @default(now())

  @@index([hostId, createdAt])
  @@map("booking_logs")
}

/// Configurações gerais do site em chave/valor (ex.: campos do Zoho CRM que
/// entram no prompt de escopo, cache cifrado do token de acesso do Zoho).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@map("app_settings")
}

// Chaves de API do Tool Center (MCP / integrações). Cada chave age como o
// usuário dono, com as mesmas permissões da tela. Só o hash SHA-256 fica
// gravado — o valor aparece uma única vez, na criação.
model ApiKey {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // Início visível da chave (ex.: tc_AbC1), para reconhecer qual é qual.
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@map("api_keys")
}

// ───────────────────────────── Estudos do time (SCs) ─────────────────────────
// A planilha "Acompanhamento de Estudo do Time" trazida para o portal: matriz de
// conhecimento (nível 0–4 por pessoa e tópico) e o registro semanal de estudos.
// Pessoas são User.id (sem FK, como no Radar, para não mexer no modelo User).

model EstudoTopico {
  id         String        @id @default(cuid())
  categoria  String
  topico     String
  descricao  String?       @db.Text
  /// nível que o time deve atingir (0–4); vazio = sem meta
  nivelAlvo  Int?
  /// Alta, Média ou Baixa
  prioridade String?
  ordem      Int           @default(0)
  criadoEm   DateTime      @default(now())
  niveis     EstudoNivel[]

  @@unique([categoria, topico])
  @@map("estudo_topicos")
}

model EstudoNivel {
  id            String       @id @default(cuid())
  topicoId      String
  topico        EstudoTopico @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  userId        Int
  /// 0 Nenhum · 1 Básico · 2 Intermediário · 3 Avançado · 4 Especialista
  nivel         Int
  atualizadoEm  DateTime     @updatedAt
  atualizadoPor Int?

  @@unique([topicoId, userId])
  @@index([userId])
  @@map("estudo_niveis")
}

model EstudoRegistro {
  id          String   @id @default(cuid())
  userId      Int
  data        DateTime @db.Date
  categoria   String?
  atividade   String   @db.Text
  tipo        String?
  observacoes String?  @db.Text
  criadoEm    DateTime @default(now())
  criadoPor   Int?
  /// atividade de Estudo do Radar que gerou este registro (uma por atividade)
  atividadeRadarId String? @unique

  @@index([data])
  @@index([userId])
  @@map("estudo_registros")
}

// ──────────────────────────────── Notificações ───────────────────────────────
// O sininho do cabeçalho. Hoje: atividade nova do Backlog para o responsável.
// userId é o User.id (sem FK, como no Radar).

model Notificacao {
  id       String    @id @default(cuid())
  userId   Int
  /// ex.: ATIVIDADE_NOVA
  tipo     String
  titulo   String
  corpo    String?   @db.Text
  /// para onde o clique leva
  link     String?
  lidaEm   DateTime?
  criadoEm DateTime  @default(now())

  @@index([userId, lidaEm])
  @@index([userId, criadoEm])
  @@map("notificacoes")
}

// ─────────────────────────── Atalhos do editor ───────────────────────────────
// Botões do editor de estimativas (Treinamento, Workshop, Go-live e os que o
// admin criar) que preenchem itens conforme regras: item + quantidade +
// condições (grupos OU, condições E). Ver lib/editor-shortcuts.ts.
// `key` é a marca gravada nas versões (__shortcut_<key>): nunca muda.

model EditorShortcut {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  name         String
  nameEn       String   @default("")
  nameEs       String   @default("")
  description  String   @default("")
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  /// [{ itemId, quantity, groups: [[condição, ...], ...] }]
  rules        Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("editor_shortcuts")
}

// ───────────────────────── Relatos (bugs e sugestões) ─────────────────────────
// Janela "Sugestões / Bugs" do cabeçalho. Quem vê e trata: SE e admin
// (/reports). Anexos ficam no próprio banco (até 4 MB cada, 5 por relato).

model FeedbackReport {
  id          Int                  @id @default(autoincrement())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  userId      Int?
  /// ferramenta (lib/tool-features.ts): estimates, aeCalculator, ..., website, demos
  feature     String
  /// bug | suggestion
  kind        String
  body        String               @db.Text
  /// new | ongoing | pending | rejected | solved
  status      String               @default("new")
  statusBy    Int?
  statusAt    DateTime?
  /// página de onde o relato foi enviado
  pageUrl     String?
  attachments FeedbackAttachment[]

  @@index([status, createdAt])
  @@map("feedback_reports")
}

model FeedbackAttachment {
  id        String         @id @default(cuid())
  reportId  Int
  report    FeedbackReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([reportId])
  @@map("feedback_attachments")
}

// ─────────────────────────────── Changelog ───────────────────────────────────
// Publicações do /changelog. Rascunhos podem ser escritos à mão (SE/admin) ou
// vir do código (lib/changelog-drafts.ts, importados como rascunho — nunca
// publicados sozinhos). Textos em pt/en/es.

model ChangelogEntry {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// draft | published | discarded
  status      String    @default("draft")
  publishedAt DateTime?
  publishedBy Int?
  createdBy   Int?
  /// manual | code
  source      String    @default("manual")
  /// id do rascunho vindo do código: não importa duas vezes
  sourceKey   String?   @unique
  /// rótulo opcional da versão (ex.: "V3 · Novembro/2026")
  release     String    @default("")
  /// { pt, en, es }
  title       Json
  /// { pt, en, es }
  summary     Json
  /// [{ kind: new | improved | fixed, feature, text: { pt, en, es } }]
  items       Json      @default("[]")

  @@index([status, publishedAt])
  @@map("changelog_entries")
}

// Alterações feitas no painel Admin (lib/admin-audit.ts). A aba "Alterações do
// Admin" do changelog lista as pendentes; marcar como publicada manda para o
// arquivo (e dá para desmarcar).
model AdminChange {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  userId      Int?
  area        String
  action      String
  summary     String    @db.Text
  details     Json?
  publishedAt DateTime?
  publishedBy Int?

  @@index([publishedAt, createdAt])
  @@map("admin_changes")
}
